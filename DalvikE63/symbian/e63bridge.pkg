; S60 3rd FP1 project: built and self-signed for LOCAL testing, not
; installed or tested on a Nokia E63. Use your own UID/certificate to deploy.
# {"E63 Java ME-SIS Bridge"}, (0xE0B63E01), 0, 1, 1
% {"EN"}
: "Local prototype"
; Match the E63 S60 3rd Edition FP1 product dependency of the UI SISX.
[0x102032BE], 0, 0, 0, {"SymbianProductID"}
"$(EPOCROOT)epoc32\release\gcce\urel\e63bridge.exe" - "!:\sys\bin\e63bridge.exe"
"$(EPOCROOT)epoc32\release\gcce\urel\e63bridge_launch.exe" - "!:\sys\bin\e63bridge_launch.exe"
"$(EPOCROOT)epoc32\data\z\resource\apps\e63bridge_launch.rsc" - "!:\resource\apps\e63bridge_launch.rsc"
"$(EPOCROOT)epoc32\data\z\private\10003a3f\import\apps\e63bridge_launch_reg.rsc" - "!:\private\10003a3f\import\apps\e63bridge_launch_reg.rsc"
